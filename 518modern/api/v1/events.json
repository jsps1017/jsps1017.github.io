_modified":"0.1"},{"id":"E12","date":"1980-05-27","date_end":null,"time":null,"time_label":"새벽","time_precision":2,"place":"옛 전남도청 일대","site_ids":["S05-1","S28"],"geo_precision":2,"actor1":"계엄군","actor2":"시민군","type":"교전","subtype":"진압 작전","summary":"계엄군이 도청 진압 작전을 벌였고 시민군은 도청에서 최후 항전을 했다. 시민군이 지키던 전일빌딩도 특공조의 점령 목표가 되어 총격을 받았다.","sources":["mpva","khan2017","rep2016#128"],"casualties":{"official":null,"by_source":[{"note":"전일빌딩: 진압에 대비해 시민군 배치, 2명 연행","source":"rep2016#128"}]},"time_by_source":[],"access":"public","lat":35.1468,"lon":126.92,"version_added":"0.1","last_modified":"0.3"},{"id":"E13","date":"1980-05-19","date_end":null,"time":"16:50","time_label":"오후 4시 50분경","time_precision":1,"place":"광주고 앞 도로","site_ids":["S21"],"geo_precision":2,"actor1":"계엄군(11공수여단 63대대)","actor2":"시위대","type":"민간인 대상 폭력","subtype":"총격","summary":"시위대가 장갑차를 포위하자 장갑차에 타고 있던 장교가 총을 쐈고, 이 과정에서 고등학생 1명이 총에 맞아 중상을 입었다. 1995년 검찰 발표는 이를 광주에서의 최초 발포로 기록했다.","sources":["newsis20191230","seoul1995"],"time_by_source":[{"source":"newsis20191230","label":"16:50"},{"source":"seoul1995","label":"17:00경"}],"casualties":{"official":null,"by_source":[{"source":"seoul1995","killed":null,"injured":1,"note":"고등학생 1명 부상"}]},"access":"public","lat":35.1588609,"lon":126.9218786,"version_added":"0.2","last_modified":"0.2"},{"id":"E14","date":"1980-05-24","date_end":null,"time":null,"time_label":"오후","time_precision":2,"place":"송암동 일대","site_ids":["S15","U21"],"geo_precision":3,"actor1":"계엄군(11공수여단)","actor2":"계엄군(전교사 보병학교 교도대)","type":"교전","subtype":"부대 간 오인 교전(주민 피해 동반)","summary":"광주비행장으로 철수하던 11공수여단이 매복 중이던 전투병과교육사령부 보병학교 교도대와 오인 교전을 벌였고, 이 일대에서 민간인들이 희생되었다.","sources":["khan2024","khan2020","rep2016#130"],"casualties":{"official":null,"by_source":[{"note":"다수의 사상자(효천역 인근, 계엄군과 기갑학교 병력의 오인사격으로 기재)","source":"rep2016#130"}]},"time_by_source":[],"access":"public","lat":35.111,"lon":126.879,"version_added":"0.2","last_modified":"0.3"},{"id":"E15","date":"1980-05-18","date_end":null,"time":"14:00","time_lab