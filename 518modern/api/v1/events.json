{"meta":{"dataset":"5·18 사적지·사건 데이터(데모)","version":"0.4","scenario":true,"notice":"데모용 예시 레코드. 공개 출처 서술을 요약했으며 사실 검증·권리 확인 전임."},"data":[{"id":"E01","date":"1980-05-18","date_end":null,"time":"10:00","time_label":"오전 10시경","time_precision":1,"place":"전남대학교 정문","site_ids":["S01"],"geo_precision":2,"actor1":"학생","actor2":"계엄군","type":"시위","subtype":"진압 개입","summary":"학교 출입을 막는 계엄군에게 정문 앞에 모인 학생들이 항의하면서 최초의 충돌이 있었고, 학생들은 광주역과 금남로로 진출해 항의 시위를 벌였다.","sources":["mpva"],"casualties":{"official":null,"by_source":[]},"time_by_source":[],"access":"public","lat":35.1762231,"lon":126.9057696,"version_added":"0.1","last_modified":"0.1"},{"id":"E02","date":"1980-05-18","date_end":null,"time":null,"time_label":"시각 미상","time_precision":2,"place":"금남로(옛 가톨릭센터 앞)","site_ids":["S04"],"geo_precision":2,"actor1":"학생·시민","actor2":"계엄군","type":"시위","subtype":"진압 개입","summary":"옛 가톨릭센터 앞에서 최초의 학생 연좌시위가 있었다. 국가기록원은 5월 18일을 광주 전체를 술렁이게 한 '피의 일요일'로 기록한다.","sources":["mpva","arch3"],"casualties":{"official":null,"by_source":[]},"time_by_source":[],"access":"public","lat":35.1495885,"lon":126.9167894,"version_added":"0.1","last_modified":"0.1"},{"id":"E03","date":"1980-05-20","date_end":null,"time":null,"time_label":"저녁","time_precision":2,"place":"금남로 일대","site_ids":["S04"],"geo_precision":3,"actor1":"시민(차량 시위)","actor2":null,"type":"시위","subtype":"평화 시위(차량)","summary":"택시를 중심으로 100여 대의 각종 차량이 참가한 대규모 시위가 금남로를 지났다.","sources":["mpva"],"casualties":{"official":null,"by_source":[]},"time_by_source":[],"access":"public","lat":35.1495885,"lon":126.9167894,"version_added":"0.1","last_modified":"0.1"},{"id":"E04","date":"1980-05-20","date_end":null,"time":null,"time_label":"시각 미상","time_precision":2,"place":"광주MBC(당시 사옥)","site_ids":["S07"],"geo_precision":1,"actor1":"시민","actor2":null,"type":"시위","subtype":"건물 방화(폭력 동반)","summary":"사실을 보도하지 않던 광주MBC 건물이 불에 탔다. 방화 혐의로 처벌받았던 시민은 2021년 재심에서 '헌정질서 파괴행위에 저항한 정당행위'로 무죄를 선고받았다.","sources":["weekly2015","hani2021"],"casualties":{"official":null,"by_source":[]},"time_by_source":[],"access":"public","lat":35.1505,"lon":126.9200911,"version_added":"0.1","last_modified":"0.1"},{"id":"E05","date":"1980-05-20","date_end":null,"time":null,"time_label":"밤","time_precision":2,"place":"광주역 일대","site_ids":["S02"],"geo_precision":2,"actor1":"계엄군","actor2":"시민","type":"민간인 대상 폭력","subtype":"총격","summary":"광주역에서 계엄군이 시민을 향해 발포했다. 국가기록원 자료는 20일 밤의 발포를 '계엄군의 첫 발포'로 서술한다.","sources":["weekly2015","arch2"],"casualties":{"official":null,"by_source":[{"source":"weekly2015","killed":2,"injured":null,"note":"사망 2명"}]},"time_by_source":[],"access":"public","lat":35.16514,"lon":126.9091,"version_added":"0.1","last_modified":"0.2"},{"id":"E06","date":"1980-05-21","date_end":null,"time":"13:00","time_label":"오후 1시","time_precision":1,"place":"옛 전남도청 앞","site_ids":["S05-1","S05-2"],"geo_precision":2,"actor1":"계엄군(공수부대)","actor2":"시민","type":"민간인 대상 폭력","subtype":"집단 발포","summary":"도청에서 애국가가 울려 퍼지는 가운데 계엄군이 시민들을 향해 집단 발포했다. 11공수특전여단 상황일지의 같은 날 오후 1시 항목에는 도청 앞 분수대 부근 사살 기록이 있다.","sources":["arch2","newsis20190425"],"casualties":{"official":null,"by_source":[]},"time_by_source":[],"access":"public","lat":35.1468,"lon":126.92,"version_added":"0.1","last_modified":"0.1"},{"id":"E07","date":"1980-05-21","date_end":null,"time":null,"time_label":"시각 미상","time_precision":2,"place":"전남대학교 일대","site_ids":["S01"],"geo_precision":2,"actor1":"계엄군","actor2":"시민","type":"민간인 대상 폭력","subtype":"집단 발포","summary":"같은 날 전남대학교에서도 집단 발포가 있었다(2차 정리 자료).","sources":["aksEdu"],"casualties":{"official":null,"by_source":[]},"time_by_source":[],"access":"public","lat":35.1762231,"lon":126.9057696,"version_added":"0.1","last_modified":"0.1"},{"id":"E08","date":"1980-05-21","date_end":null,"time":null,"time_label":"오후~저녁","time_precision":2,"place":"옛 전남도청 및 시내","site_ids":["S05-1"],"geo_precision":3,"actor1":"시민군","actor2":"계엄군","type":"전략적 변화","subtype":"계엄군 철수","summary":"계엄군이 도청에서 물러나 광주시 외곽으로 철수했다.","sources":["mpva","arch3","arch2"],"time_by_source":[{"source":"arch3"